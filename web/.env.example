# Copy to web/.env.local. Never commit real keys. All keys are used server-side only.

# ---- Chain ----
# 97 = BNB Chain testnet · 11155111 = Ethereum Sepolia · 10143 = Monad testnet · 31337 = local Anvil
NEXT_PUBLIC_CHAIN_ID=97
# RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
AGENT_PRIVATE_KEY=        # KRIYA agent (bounded: can only call executeAllocation)
ADMIN_PRIVATE_KEY=        # protocol owner, used by the keeper to post verified risk scores

# ---- Decision engine ----
ANTHROPIC_API_KEY=
# KRIYA_MODEL=claude-sonnet-5-5
# KRIYA_LLM=off           # use the deterministic optimizer only

# ---- Market Risk Engine (BNB Bangkok) ----
CMC_API_KEY=              # CoinMarketCap Pro API
# CMC_CACHE_MS=60000      # cache window that protects API credits
# Atlas Oracle feeds on BNB Chain (AggregatorV3-compatible), from docs.atlasoracle.io / the Atlas team
ATLAS_FEED_BNB_USD=
ATLAS_FEED_USDT_USD=
ATLAS_FEED_USDC_USD=
# ATLAS_MAX_AGE_SECONDS=86400
COURNOT_API_KEY=          # prepaid key; without it each IP has 3 free probability calls in total
# MARKET_RISK=off         # fall back to the demo risk feed

# ---- Living Brain (ChatAndBuild) ----
LIVING_BRAIN_API_KEY=
# LIVING_BRAIN_NAME=KRIYA

# ---- Hosted demo state (optional, Vercel) ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
